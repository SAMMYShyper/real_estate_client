---
import "../../styles/site.css";

const aboutParagraph = 'Pegue aqui su parrafo de Sobre Nosotros.';
const aboutImage = '/house_interior.jpeg';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Comparta su resena y experiencia trabajando con Amigos House Buyer."
		/>
		<link rel="canonical" href="/es/reviews/" />
		<link rel="alternate" hreflang="en" href="/reviews/" />
		<link rel="alternate" hreflang="es" href="/es/reviews/" />
		<link rel="alternate" hreflang="x-default" href="/reviews/" />
		<title>Resenas | Amigos House Buyer</title>
	</head>
	<body>
		<header class="site-header" aria-label="Encabezado del sitio">
			<div class="top-bar">
				<p>Preocupado por proteger su credito? Llamenos, nosotros podemos ayudarle.</p>
				<a href="tel:18636603118" aria-label="Llamar a Amigos House Buyer al 863 660 3118">
					863 660 3118
				</a>
			</div>

			<nav class="nav" aria-label="Navegacion principal">
				<div class="brand-group">
					<a class="brand" href="/es/" aria-label="Inicio de Amigos House Buyer">
						<img class="brand-logo" src="/logo.png" alt="Logo de Amigos House Buyer" />
					</a>
					<div class="language-switch" aria-label="Opciones de idioma">
						<a href="/reviews/">For English, click here.</a>
						<a href="/es/reviews/" aria-current="page">ES</a>
					</div>
				</div>
				<div class="nav-links">
					<a href="/es/">Venda Su Casa</a>
					<a href="/es/reviews/" aria-current="page">Nuestra Historia</a>
					<a href="/es/faq/">FAQ</a>
					<a href="tel:18636603118" class="nav-call">Llamar</a>
				</div>
			</nav>
		</header>

		<main>
			<section class="about-section" aria-label="Sobre Amigos House Buyer">
				<div class="about-copy">
					<p class="section-kicker">Sobre nosotros</p>
					<h2>Ayudamos a los propietarios a avanzar.</h2>
					<p>Nos dedicamos a remodelar y vender casas, en el proceso ayudamos a nuestros vecinos a sobrellevar retos financieros temporales comprando sus propiedades de manera directa.</p>
				</div>
				<img src={aboutImage} alt="Interior de una casa" />
			</section>

			<section class="page-hero">
				<div class="page-hero-inner">
					<p class="eyebrow">Resenas de clientes</p>
					<h1>Comparta su experiencia con Amigos House Buyer.</h1>
					<p>
						Quiere compartir su experiencia con nosotros? Envienos una nota para contarnos como
						fue trabajar con Amigos House Buyer LLC.
					</p>
				</div>
			</section>

			<section class="review-section" aria-label="Enviar una resena">
				<div class="review-copy">
					<p class="section-kicker">Deje una resena</p>
					<h2>Nos encantaria saber de usted.</h2>
				</div>

				<form class="review-form" aria-label="Formulario para enviar resena">
					<div class="field-grid">
						<label>
							<span>Nombre</span>
							<input type="text" name="name" autocomplete="name" placeholder="Su nombre" />
						</label>
						<label>
							<span>Email</span>
							<input type="email" name="email" autocomplete="email" placeholder="usted@example.com" />
						</label>
					</div>

					<label>
						<span>Calificacion</span>
						<select name="rating">
							<option value="">Seleccione una calificacion</option>
							<option value="5">5 estrellas</option>
							<option value="4">4 estrellas</option>
							<option value="3">3 estrellas</option>
							<option value="2">2 estrellas</option>
							<option value="1">1 estrella</option>
						</select>
					</label>

					<label>
						<span>Su resena</span>
						<textarea
							name="review"
							rows="7"
							placeholder="Cuentenos como fue trabajar con Amigos House Buyer."></textarea>
					</label>

					<button type="submit">Enviar Resena</button>
					<p class="form-note">Gracias por tomar el tiempo de compartir su experiencia.</p>
				</form>
			</section>
		</main>
	</body>
</html>

<style>
	.about-section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
		align-items: center;
		gap: clamp(28px, 6vw, 80px);
		max-width: 1160px;
		margin: 0 auto;
		padding: 185px clamp(18px, 6vw, 86px) clamp(42px, 6vw, 76px);
	}

	.about-copy {
		display: grid;
		gap: 16px;
	}

	.about-copy h2,
	.about-copy p {
		margin: 0;
	}

	.about-copy h2 {
		font-size: clamp(2rem, 4.5vw, 4rem);
		line-height: 1;
	}

	.about-copy p:last-child {
		max-width: 620px;
		color: var(--muted);
		font-size: 1.06rem;
		line-height: 1.7;
	}

	.about-section img {
		width: 100%;
		height: 340px;
		border-radius: 8px;
		object-fit: cover;
	}

	.about-section + .page-hero {
		padding-top: 32px;
	}

	@media (max-width: 920px) {
		.about-section {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.about-section {
			padding-top: 214px;
		}

		.about-section + .page-hero {
			padding-top: 28px;
		}
	}
</style>
